# Knot & Bloom Environment Configuration

# Database: Default SQLite for zero-config local run, switch to PostgreSQL when ready:
# SQLite:
DATABASE_URL="file:./dev.db"
# PostgreSQL (Optional production):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/knotandbloom?schema=public"

# Authentication Secret
JWT_SECRET="knotandbloom-luxury-secret-key-super-secure-2026"
NEXTAUTH_SECRET="knotandbloom-luxury-secret-key-super-secure-2026"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

